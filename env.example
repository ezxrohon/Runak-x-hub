# Add these in Vercel: Project -> Settings -> Environment Variables (then redeploy).
# Or via CLI:  vercel env add TMDB_KEY production   (repeat for each)

# REQUIRED - free at themoviedb.org/settings/api (v3 key or v4 read token)
TMDB_KEY=

# OPTIONAL - IMDb / Rotten Tomatoes / Metacritic ratings. Free at omdbapi.com/apikey.aspx
OMDB_KEY=

# OPTIONAL - streaming links per platform (India). Free tier at api.watchmode.com
WATCHMODE_KEY=

# OPTIONAL - Trakt ratings. Free app at trakt.tv/oauth/applications (use the Client ID)
TRAKT_CLIENT_ID=

# No key needed (already built in): TVMaze, Jikan (MyAnimeList), AniList, Wikipedia
